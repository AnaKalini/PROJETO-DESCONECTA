<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <title>Meu editar</title>
        <link rel="icon" type="image/png" href="/logo.png">
        <link rel="stylesheet" href="/style.css"
    </head>

    <body>
        <header>   
            <img class="logo src="/logo.png" alt="Logo Desconecta+">
        </header>
        <h2>Desconect+ - Editar Registro</h2>
        <% crud.forEach(function(details) { %>
            <form action="/edit/<%= details._id %>" method="POST">
                <input type="text" value="<%= details.nomeCompleto %>" name="nomeCompleto">
                <input type="text" value="<%= details.cpf %>" name="cpf">
                <input type="text" value="<%= details.telefone %>" name="telefone">
                <input type="email" value="<%= details.email %>" name="email">
                <br/>
                <button>
                    <a href="/show">Todos</a>
                </button>
                <button type="submit">Editar</button>
            </form>
        <% }) %>
    </body>

</html>