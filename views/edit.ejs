<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <title>Meu editar</title>
    </head>

    <body>
        <h2>Editar Registro</h2>
        <% crud.forEach(function(details) { %>
            <form action="/edit/<%= details._id %>" method="POST">
                <input type="text" value="<%= details.nomeCompleto %>" name="nomeCompleto">
                <input type="text" value="<%= details.endereço %>" name="endereço">
                <input type="email" value="<%= details.cpf %>" name="cpf">
                <input type="text" value="<%= details.telefone %>" name="telefone">
                <input type="email" value="<%= details.email %>" name="email">
                <br/>
                <button>
                    <a href="/show">Todos</a>
                </button>
                <button type="submit">Editar</button>
            </form>
        <% }) %>
    </body>

</html>