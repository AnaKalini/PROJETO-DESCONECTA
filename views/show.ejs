<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>+Desconecta</title>
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
     <header>   
            <img class="logo src="/logo.png" alt="Logo Desconecta+">
            <h1>Desconecta+ - Cadastro</h1>
            <p> node.JS + express + EJS + MongoDB</p>
        </header>
        <div class="container"></div>
    <h2>Registros</h2>
    <table border="1">
        <thead>
            <tr>
                <td>Nome Completo</td>
                <td>CPF</td>
                <td>Telefone</td>
                <td>E-mail</td>
                <td>Ação</td>
            </tr>
        </thead>
        <tbody>
            <% crud.forEach(function(details) { %>
                <tr>
                    <td><%= details.nomeCompleto %></td>
                    <td><%= details.cpf %></td>
                    <td><%= details.telefone %></td>
                    <td><%= details.email %></td>
                    <td>
                        <a href="/edit/<%= details._id %>">Editar</a> -
                        <a href="/delete/<%= details._id %>">Deletar</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <br>
    <button><a href="/index" class="btn">Novo</a></button>
</div>
</body>

</html>