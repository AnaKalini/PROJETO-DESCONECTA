<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>+Desconecta</title>
</head>

<body>
    <h2>Registros</h2>
    <table border="1">
        <thead>
            <tr>
                <td>Nome Completo</td>
                <td>Endereço</td>
                <td>CPF</td>
                <td>Telefone</td>
                <td>E-mail</td>
                <td>Ação</td>
            </tr>
        </thead>
        <tbody>
            <% crud.forEach(function(details) { %>
                <tr>
                    <td><%= details.nomeCompleto %></td>
                    <td><%= details.cpf %></td>
                    <td><%= details.telefone %></td>
                    <td><%= details.email %></td>
                    <td>
                        <a href="/edit/<%= details._id %>">Editar</a> -
                        <a href="/delete/<%= details._id %>">Deletar</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <br>
    <button><a href="/index">Novo</a></button>
</body>

</html>